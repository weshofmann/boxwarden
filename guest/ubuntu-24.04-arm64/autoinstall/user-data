#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: "__BOXWARDEN_TIMEZONE__"
  network:
    version: 2
    renderer: NetworkManager
    ethernets:
      boxwarden-ethernet:
        match:
          name: "en*"
        dhcp4: true
  apt:
    preserve_sources_list: false
    mirror-selection:
      primary:
        - uri: http://ports.ubuntu.com/ubuntu-ports
          arches: [arm64]
    fallback: abort
    geoip: false
  source:
    id: ubuntu-desktop
    search_drivers: false
  storage:
    layout:
      name: direct
  identity:
    realname: Boxwarden Task 0
    hostname: boxwarden-task0-__BOXWARDEN_RUN_ID__
    username: boxwarden
    password: "__BOXWARDEN_PASSWORD_HASH__"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys: []
  drivers:
    install: false
  codecs:
    install: false
  oem:
    install: false
  packages:
    - curl
    - dnsutils
    - netcat-openbsd
    - openssh-server
    - x11-apps
    - xwayland
  late-commands:
    # Required EFI can appear after systemd's default device deadline during
    # a slow boot. Keep the mount required, with a finite guest-only wait.
    - |
      python3 - /target/etc/fstab <<'BW_EFI_PY'
      import os, pathlib, re, stat, sys, tempfile
      path = pathlib.Path(sys.argv[1])
      fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
      with os.fdopen(fd, "rb") as source:
          before = os.fstat(source.fileno())
          if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > 65536:
              raise SystemExit("unexpected installer fstab file")
          data = source.read(65537)
      if len(data) > 65536:
          raise SystemExit("installer fstab exceeds bound")
      rows = data.splitlines(keepends=True)
      entries = []
      for index, row in enumerate(rows):
          fields = list(re.finditer(rb"\S+", row.split(b"#", 1)[0]))
          if len(fields) > 1 and fields[1].group() == b"/boot/efi":
              entries.append((index, fields))
      if len(entries) != 1:
          raise SystemExit("installer fstab needs exactly one required EFI entry")
      index, fields = entries[0]
      values = [field.group() for field in fields]
      options = b"defaults,x-systemd.device-timeout=10min"
      if (len(values) != 6 or not re.fullmatch(rb"(?:/dev/disk/by-uuid/|UUID=)[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}", values[0])
              or values[2] != b"vfat" or values[3] not in (b"defaults", options) or values[4:] != [b"0", b"1"]):
          raise SystemExit("unexpected installer EFI entry")
      if values[3] == options:
          raise SystemExit(0)
      row = rows[index]
      rows[index] = row[:fields[3].start()] + options + row[fields[3].end():]
      current = path.lstat()
      if (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns) != (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns):
          raise SystemExit("installer fstab changed before replacement")
      fd, temporary = tempfile.mkstemp(prefix=".boxwarden-efi-", dir=path.parent)
      try:
          with os.fdopen(fd, "wb") as output:
              os.fchown(output.fileno(), before.st_uid, before.st_gid)
              os.fchmod(output.fileno(), stat.S_IMODE(before.st_mode))
              output.write(b"".join(rows))
              output.flush()
              os.fsync(output.fileno())
          os.replace(temporary, path)
          directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
          try:
              os.fsync(directory)
          finally:
              os.close(directory)
      finally:
          if os.path.exists(temporary):
              os.unlink(temporary)
      BW_EFI_PY
    - install -d -o root -g root -m 0755 /target/etc/ssh/sshd_config.d /target/etc/ssh/boxwarden
    - |
      cat > /target/etc/ssh/sshd_config.d/60-boxwarden-task0.conf <<'EOF'
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AuthorizedKeysFile .ssh/authorized_keys
      TrustedUserCAKeys /etc/ssh/boxwarden/active/trusted-user-ca.pub
      AuthorizedPrincipalsFile /etc/ssh/boxwarden/active/authorized_principals/%u
      AllowAgentForwarding no
      AllowTcpForwarding no
      AllowStreamLocalForwarding no
      GatewayPorts no
      X11Forwarding no
      PermitTunnel no
      PermitUserEnvironment no
      PermitUserRC no
      EOF
    - install -d -o root -g root -m 0755 /target/usr/local/libexec
    - "printf '%s  %s\\n' 'ecdb752197c6d36f9594d234e4035745f55e1e38c95426a78d473e5d26dadf06' '/cdrom/boxwarden-artifacts/boxwarden-guest-bootstrap' | sha256sum -c -"
    - install -o root -g root -m 0755 /cdrom/boxwarden-artifacts/boxwarden-guest-bootstrap /target/usr/local/libexec/boxwarden-guest-bootstrap
    - "printf '%s  %s\\n' '__BOXWARDEN_FINALIZER_SHA256__' '/cdrom/boxwarden-artifacts/finalize-golden.sh' | sha256sum -c -"
    - install -o root -g root -m 0755 /cdrom/boxwarden-artifacts/finalize-golden.sh /target/usr/local/libexec/boxwarden-finalize-golden
    - "printf '%s  %s\\n' '__BOXWARDEN_RECIPE_HELPER_SHA256__' '/cdrom/boxwarden-artifacts/recipe-prepare.py' | sha256sum -c -"
    - install -o root -g root -m 0755 /cdrom/boxwarden-artifacts/recipe-prepare.py /target/usr/local/libexec/boxwarden-recipe-prepare
    - "printf '%s  %s\\n' '__BOXWARDEN_CHATGPT_INSTALLER_SHA256__' '/cdrom/boxwarden-artifacts/install-pinned-chatgpt.py' | sha256sum -c -"
    - install -o root -g root -m 0755 /cdrom/boxwarden-artifacts/install-pinned-chatgpt.py /target/usr/local/libexec/boxwarden-install-pinned-chatgpt
    - "printf '%s  %s\\n' '__BOXWARDEN_CHATGPT_LAUNCHER_SHA256__' '/cdrom/boxwarden-artifacts/launch-chatgpt.py' | sha256sum -c -"
    - install -o root -g root -m 0755 /cdrom/boxwarden-artifacts/launch-chatgpt.py /target/usr/local/libexec/boxwarden-launch-chatgpt
    - "printf '%s  %s\\n' '__BOXWARDEN_RECIPE_PAYLOAD_SHA256__' '/cdrom/boxwarden-artifacts/recipe-prepare.json' | sha256sum -c -"
    - install -d -o root -g root -m 0700 /target/var/lib/boxwarden
    - install -o root -g root -m 0600 /cdrom/boxwarden-artifacts/recipe-prepare.json /target/var/lib/boxwarden/recipe-prepare.json
    - "printf '%s\\n' '__BOXWARDEN_RUN_ID__' > /target/etc/boxwarden-task0-spike"
    - chmod 0644 /target/etc/boxwarden-task0-spike
    - curtin in-target -- install -d -o boxwarden -g boxwarden -m 0700 /home/boxwarden/.config
    - curtin in-target -- install -o boxwarden -g boxwarden -m 0600 /dev/null /home/boxwarden/.config/gnome-initial-setup-done
    - sed -i 's/^#  AutomaticLoginEnable = true/AutomaticLoginEnable = true/' /target/etc/gdm3/custom.conf
    - sed -i 's/^#  AutomaticLogin = user1/AutomaticLogin = boxwarden/' /target/etc/gdm3/custom.conf
    - |
      cat > /target/etc/sudoers.d/90-boxwarden <<'EOF'
      boxwarden ALL=(ALL:ALL) NOPASSWD: ALL
      EOF
    - chmod 0440 /target/etc/sudoers.d/90-boxwarden
    - curtin in-target -- visudo -cf /etc/sudoers.d/90-boxwarden
    - install -d -m 0755 /target/etc/default/grub.d
    - |
      cat > /target/etc/default/grub.d/99-boxwarden-timeout.cfg <<'EOF'
      GRUB_TIMEOUT=1
      GRUB_RECORDFAIL_TIMEOUT=1
      EOF
    - chmod 0644 /target/etc/default/grub.d/99-boxwarden-timeout.cfg
    - curtin in-target -- update-grub
    - install -d -m 0755 /target/etc/systemd/system/serial-getty@hvc0.service.d
    - |
      cat > /target/etc/systemd/system/serial-getty@hvc0.service.d/10-boxwarden-autologin.conf <<'EOF'
      [Unit]
      After=boxwarden-firstboot-identity.service

      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin boxwarden --noclear --keep-baud 115200,57600,38400,9600 - $TERM
      EOF
    - curtin in-target -- systemctl enable serial-getty@hvc0.service
    - install -d -m 0755 /target/etc/dconf/profile /target/etc/dconf/db/local.d/locks
    - |
      cat > /target/etc/dconf/profile/user <<'EOF'
      user-db:user
      system-db:local
      EOF
    - |
      cat > /target/etc/dconf/db/local.d/00-boxwarden-session <<'EOF'
      [org/gnome/desktop/session]
      idle-delay=uint32 0

      [org/gnome/desktop/screensaver]
      idle-activation-enabled=false
      lock-enabled=false
      ubuntu-lock-on-suspend=false

      [org/gnome/settings-daemon/plugins/power]
      sleep-inactive-ac-timeout=0
      sleep-inactive-ac-type='nothing'
      sleep-inactive-battery-timeout=0
      sleep-inactive-battery-type='nothing'
      EOF
    - |
      cat > /target/etc/dconf/db/local.d/locks/00-boxwarden-session <<'EOF'
      /org/gnome/desktop/session/idle-delay
      /org/gnome/desktop/screensaver/idle-activation-enabled
      /org/gnome/desktop/screensaver/lock-enabled
      /org/gnome/desktop/screensaver/ubuntu-lock-on-suspend
      /org/gnome/settings-daemon/plugins/power/sleep-inactive-ac-timeout
      /org/gnome/settings-daemon/plugins/power/sleep-inactive-ac-type
      /org/gnome/settings-daemon/plugins/power/sleep-inactive-battery-timeout
      /org/gnome/settings-daemon/plugins/power/sleep-inactive-battery-type
      EOF
    - curtin in-target -- dconf update
    - curtin in-target -- systemctl enable ssh
    - curtin in-target -- ufw default deny incoming
    - curtin in-target -- ufw default allow outgoing
    - curtin in-target -- ufw allow 22/tcp
    - curtin in-target -- ufw --force enable
  shutdown: reboot
