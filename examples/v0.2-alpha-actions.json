{
  "version": 1,
  "source": {
    "kind": "ubuntu-24.04.4-desktop-arm64",
    "sha256": "c2610520bf582976839a1724c669e1cfed0547427be5a0ad12d457b92b46ffbe"
  },
  "machine": {
    "cpus": 4,
    "memory_mib": 4096,
    "system_disk_gib": 30
  },
  "apt_packages": ["git", "curl", "ca-certificates", "nodejs"],
  "steps": [
    {
      "id": "record-first-start",
      "phase": "once",
      "argv": ["/usr/bin/python3", "-c", "from pathlib import Path; Path('/home/boxwarden/.boxwarden-alpha-once').write_text('once\\n')"]
    },
    {
      "id": "count-starts",
      "phase": "startup",
      "argv": ["/usr/bin/python3", "-c", "from pathlib import Path; marker=Path('/home/boxwarden/.boxwarden-alpha-once'); assert marker.read_text() == 'once\\n'; count=Path('/home/boxwarden/.boxwarden-alpha-starts'); count.write_text(str(int(count.read_text()) + 1 if count.exists() else 1) + '\\n')"]
    }
  ],
  "workspaces": [
    {
      "name": "project",
      "mount": "/home/boxwarden/workspaces/project"
    }
  ],
  "launch": []
}
