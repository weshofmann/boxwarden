    {
      "id": "open-chatgpt",
      "phase": "startup",
      "argv": ["/usr/local/libexec/boxwarden-launch-chatgpt"]
    }
  ],
  "workspaces": [
    {
      "name": "project",
      "mount": "/home/boxwarden/workspaces/project"
    }
  ],
  "launch": []
}
