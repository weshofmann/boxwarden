+fn sysctl(name:&CStr)->io::Result<String>{
+    let mut b=[0u8;     128];
+    let mut n=b.len();
+    if unsafe{
+        libc::sysctlbyname(name.as_ptr(),b.as_mut_ptr().cast(),&mut n,std::ptr::null_mut(),0)
+    }!=0||n==0||n>b.len(){
+        return Err(reject());
+    }CStr::from_bytes_with_nul(&b[..n]).map_err(|_|reject())?.to_str().map(str::to_owned).map_err(|_|reject())
+}
